#version 450
// SPDX-License-Identifier: GPL-3.0-or-later
// Probe 2b: memory read bandwidth.
// Grid-stride read of p0 16-byte elements; the XOR keeps every load live.
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer In { uvec4 v[]; };
layout(std430, binding = 1) buffer Out { uint o[]; };
layout(push_constant) uniform P { uint p0, p1, p2, p3; } pc;

void main()
{
    uint stride = gl_NumWorkGroups.x * 256u;
    uint acc = 0u;
    for (uint i = gl_GlobalInvocationID.x; i < pc.p0; i += stride) {
        uvec4 x = v[i];
        acc ^= x.x ^ x.y ^ x.z ^ x.w;
    }
    if (acc == 0x9E3779B9u) o[gl_GlobalInvocationID.x & 0xFFFFFu] = acc;
}
